# Copy to vars-prod.tfvars and set values. Do not commit real tfvars with secrets.
# Prefer passing secrets via GitHub Secrets and -var "okta_secret_id=$OKTA_SECRET_ID" in workflows.

region            = "us-east-1"
okta_org_name     = "your-org-subdomain"
okta_base_url     = "okta.com"
okta_scopes       = ["okta.groups.manage"]
okta_client_id    = "your-client-id"
okta_private_key_id = "your-private-key-kid"
okta_secret_id    = "your-secrets-manager-secret-id"
